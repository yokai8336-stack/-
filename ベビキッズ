/* =========================
 STATE
========================= */

let liked=JSON.parse(localStorage.getItem("bk_liked")||"[]");

let disliked=JSON.parse(localStorage.getItem("bk_disliked")||"[]");

let reviews=JSON.parse(localStorage.getItem("bk_reviews")||"[]");

let hiddenSales=JSON.parse(localStorage.getItem("bk_hiddenSales")||"[]");

let currentIndex=0;

let ageFilter="all";

let selectedHotel=null;

let reviewKids=0;

let reviewParents=0;


/* =========================
 UTIL
========================= */

function save(){

 localStorage.setItem("bk_liked",JSON.stringify(liked));

 localStorage.setItem("bk_disliked",JSON.stringify(disliked));

 localStorage.setItem("bk_reviews",JSON.stringify(reviews));

 localStorage.setItem("bk_hiddenSales",JSON.stringify(hiddenSales));

}


function stars(n){

 return "★".repeat(n)+"☆".repeat(5-n);

}


function toast(text){

 const el=document.getElementById("toast");

 el.innerText=text;

 el.style.display="block";

 setTimeout(()=>{
   el.style.display="none";
 },1600);

}


function openPage(id){

 document.querySelectorAll(".page")
 .forEach(p=>p.classList.remove("active"));

 document.getElementById(id)
 .classList.add("active");

 window.scrollTo(0,0);

}


function openProfile(){

 openPage("profilePage");

 renderProfile();

}


/* =========================
 FILTER
========================= */

function filterAge(age,button){

 ageFilter=age;

 document.querySelectorAll(".filters button")
 .forEach(b=>b.classList.remove("active"));

 button.classList.add("active");

 currentIndex=0;

 renderDeck();

}


/* =========================
 HOTEL LIST
========================= */

function availableHotels(){

 return hotels.filter(h=>{

   if(disliked.includes(h.id)) return false;

   if(ageFilter==="all") return true;

   return h.age.includes(ageFilter);

 });

}


/* =========================
 CARD
========================= */

function renderDeck(){

 const deck=document.getElementById("deck");

 const list=availableHotels();

 if(!list.length){

   deck.innerHTML=`
