<style>
*{box-sizing:border-box}

body{
 margin:0;
 background:#e9e5df;
 color:#222;
 font-family:-apple-system,BlinkMacSystemFont,"Noto Sans JP",Arial,sans-serif;
}

button,input,textarea,select{
 font:inherit;
}

button{
 cursor:pointer;
}

#app{
 width:100%;
 max-width:480px;
 min-height:100vh;
 margin:auto;
 background:#fff;
 position:relative;
}

header{
 height:68px;
 padding:10px 17px;
 display:flex;
 justify-content:space-between;
 align-items:center;
 border-bottom:1px solid #eee;
 position:sticky;
 top:0;
 background:rgba(255,255,255,.96);
 backdrop-filter:blur(12px);
 z-index:50;
}

.logo{
 font-size:24px;
 font-weight:900;
 letter-spacing:-1px;
}

.logo span{
 color:#ff6868;
}

.tagline{
 font-size:9px;
 color:#888;
 margin-top:2px;
}

.headerButton{
 width:40px;
 height:40px;
 border:0;
 border-radius:50%;
 background:#f1eee9;
}

.page{
 display:none;
 padding-bottom:90px;
 min-height:calc(100vh - 68px);
}

.page.active{
 display:block;
}

.hero{
 padding:25px 20px 10px;
}

.hero h1{
 font-size:29px;
 line-height:1.25;
 margin:0 0 9px;
 letter-spacing:-1px;
}

.hero p{
 font-size:12px;
 line-height:1.8;
 color:#777;
 margin:0;
}

.filters{
 display:flex;
 gap:7px;
 overflow-x:auto;
 padding:10px 17px 15px;
}

.filters::-webkit-scrollbar{
 display:none;
}

.filters button{
 border:0;
 background:#f0ede8;
 padding:10px 14px;
 border-radius:30px;
 font-size:11px;
 font-weight:800;
 white-space:nowrap;
}

.filters button.active{
 background:#222;
 color:white;
}

/* CARD */

.deck{
 height:625px;
 position:relative;
 padding:0 15px;
}

.card{
 position:absolute;
 inset:0 15px;
 background:white;
 border-radius:25px;
 overflow:hidden;
 box-shadow:0 10px 30px rgba(0,0,0,.14);
 transition:.25s;
}

.card.back{
 transform:scale(.95) translateY(12px);
 opacity:.35;
 z-index:1;
}

.card.front{
 z-index:2;
}

.cardVisual{
 height:290px;
 position:relative;
 display:flex;
 align-items:center;
 justify-content:center;
 font-size:90px;
 overflow:hidden;
}

.cardVisual.nasu{
 background:linear-gradient(135deg,#b8d9c0,#dfe9cf);
}

.cardVisual.okinawa{
 background:linear-gradient(135deg,#91d8df,#f6d8b7);
}

.cardVisual.kohama{
 background:linear-gradient(135deg,#61c6d6,#f4ddaa);
}

.cardVisual.miyako{
 background:linear-gradient(135deg,#4dbfd1,#e5d49d);
}

.cardVisual.tomamu{
 background:linear-gradient(135deg,#d9e7ef,#c5d5bd);
}

.cardVisual.yatsugatake{
 background:linear-gradient(135deg,#b9d6c1,#eee0bd);
}

.cardBadge{
 position:absolute;
 top:14px;
 left:14px;
 background:white;
 padding:8px 12px;
 border-radius:30px;
 font-size:11px;
 font-weight:900;
}

.cardLocation{
 position:absolute;
 bottom:15px;
 left:17px;
 color:white;
 font-size:11px;
 font-weight:700;
 text-shadow:0 1px 5px #555;
}

.cardBody{
 padding:15px;
}

.cardBody h2{
 margin:0;
 font-size:21px;
 line-height:1.2;
}

.sub{
 font-size:10px;
 color:#888;
 margin-top:4px;
}

.score{
 margin:11px 0;
 background:#f6f3ee;
 padding:11px;
 border-radius:13px;
 font-size:12px;
 font-weight:900;
}

.stats{
 display:grid;
 grid-template-columns:1fr 1fr;
 gap:7px;
}

.stat{
 background:#f5f3ef;
 border-radius:12px;
 padding:9px;
 font-size:9px;
 color:#777;
}

.stat b{
 display:block;
 font-size:12px;
 color:#222;
 margin-top:4px;
}

.quote{
 margin-top:10px;
 background:#fff5ed;
 padding:11px;
 border-radius:13px;
 font-size:10px;
 line-height:1.7;
}

.tags{
 margin-top:8px;
 font-size:9px;
 color:#555;
}

.actionArea{
 display:grid;
 grid-template-columns:1fr 1fr;
 gap:7px;
 margin-top:10px;
}

.actionArea button{
 border:0;
 padding:12px;
 border-radius:13px;
 font-size:11px;
 font-weight:900;
}

.dislike{
 background:#eee;
}

.like{
 background:#ff6868;
 color:white;
}

.detailButton{
 width:100%;
 margin-top:7px;
 padding:11px;
 border:0;
 border-radius:13px;
 background:#222;
 color:white;
 font-size:11px;
 font-weight:900;
}

.swipeText{
 text-align:center;
 color:#999;
 font-size:9px;
 padding:5px 0 12px;
}

/* COMMON */

.sectionTitle{
 padding:22px 20px 10px;
}

.sectionTitle h1{
 margin:0;
 font-size:25px;
}

.sectionTitle p{
 margin:6px 0 0;
 font-size:11px;
 color:#888;
}

.searchBox{
 margin:10px 18px;
}

.searchBox input{
 width:100%;
 border:0;
 background:#f2efeb;
 border-radius:14px;
 padding:14px;
 outline:none;
}

.listCard{
 margin:10px 18px;
 border-radius:17px;
 background:#f7f5f1;
 overflow:hidden;
}

.listContent{
 padding:14px;
}

.listContent h3{
 margin:0 0 5px;
 font-size:15px;
}

.listContent p{
 font-size:11px;
 line-height:1.6;
 color:#777;
}

.smallButton{
 border:0;
 background:#222;
 color:white;
 border-radius:10px;
 padding:8px 11px;
 font-size:10px;
 font-weight:800;
}

.empty{
 text-align:center;
 padding:60px 20px;
 color:#999;
}

.emptyIcon{
 font-size:50px;
}

/* SALE */

.saleCard{
 margin:12px 18px;
 padding:17px;
 background:#222;
 color:white;
 border-radius:20px;
}

.saleCard small{
 color:#aaa;
 font-size:9px;
}

.saleCard h3{
 margin:6px 0;
 font-size:17px;
}

.saleCard p{
 color:#ccc;
 font-size:10px;
 line-height:1.7;
}

.saleButtons{
 display:flex;
 gap:7px;
}

.saleButtons button{
 border:0;
 border-radius:10px;
 padding:10px 13px;
 font-size:10px;
 font-weight:800;
}

.saleGo{
 background:#ff6868;
 color:white;
}

.saleHide{
 background:#444;
 color:#ccc;
}

/* PROFILE */

.profileBox{
 margin:15px 18px;
 background:#f5f2ed;
 padding:18px;
 border-radius:20px;
}

.profileBox h2{
 margin:0 0 5px;
 font-size:20px;
}

.profileItem{
 background:white;
 border-radius:14px;
 padding:13px;
 margin-top:8px;
 font-size:11px;
}

.profileItem b{
 display:block;
 font-size:12px;
 margin-bottom:4px;
}

/* REVIEWS */

.review{
 margin:10px 18px;
 padding:15px;
 background:#f6f3ee;
 border-radius:16px;
}

.review h3{
 margin:0 0 5px;
 font-size:14px;
}

.review p{
 font-size:11px;
 line-height:1.7;
}

.review small{
 color:#999;
}

/* MODAL */

.modal{
 position:fixed;
 inset:0;
 background:rgba(0,0,0,.6);
 z-index:100;
 display:none;
 align-items:flex-end;
}

.modal.show{
 display:flex;
}

.modalBox{
 width:100%;
 max-width:480px;
 max-height:92vh;
 overflow:auto;
 background:white;
 border-radius:25px 25px 0 0;
 padding-bottom:30px;
}

.modalHead{
 padding:17px;
 border-bottom:1px solid #eee;
 display:flex;
 justify-content:space-between;
 align-items:center;
}

.modalHead button{
 width:35px;
 height:35px;
 border:0;
 border-radius:50%;
 background:#eee;
}

.modalContent{
 padding:18px;
}

.modalContent h2{
 margin-top:0;
 font-size:23px;
}

.modalContent h3{
 font-size:14px;
 margin-top:20px;
}

.modalContent p{
 font-size:12px;
 line-height:1.8;
}

.modalScore{
 background:#222;
 color:white;
 border-radius:14px;
 padding:15px;
 font-weight:900;
}

.modalButton{
 width:100%;
 border:0;
 background:#ff6868;
 color:white;
 padding:14px;
 border-radius:13px;
 font-weight:900;
 margin-top:10px;
}

/* FORM */

.form{
 padding:18px;
}

.form label{
 display:block;
 margin-top:15px;
 font-size:11px;
 font-weight:900;
}

.form input,
.form textarea,
.form select{
 width:100%;
 margin-top:6px;
 border:1px solid #ddd;
 border-radius:12px;
 padding:12px;
 outline:none;
}

.starButtons{
 display:flex;
 gap:5px;
 margin-top:7px;
}

.starButtons button{
 border:0;
 background:#eee;
 padding:9px 11px;
 border-radius:8px;
}

.starButtons button.selected{
 background:#222;
 color:white;
}

.submitButton{
 width:100%;
 border:0;
 background:#ff6868;
 color:white;
 padding:15px;
 border-radius:14px;
 font-weight:900;
 margin-top:20px;
}

/* NAV */

.bottomNav{
 position:fixed;
 bottom:0;
 left:50%;
 transform:translateX(-50%);
 width:min(480px,100%);
 height:72px;
 background:rgba(255,255,255,.97);
 backdrop-filter:blur(12px);
 border-top:1px solid #eee;
 display:grid;
 grid-template-columns:repeat(5,1fr);
 z-index:60;
}

.bottomNav button{
 border:0;
 background:transparent;
 color:#888;
 font-size:8px;
}

.bottomNav b{
 display:block;
 font-size:21px;
 color:#222;
 margin-bottom:2px;
}

/* TOAST */

#toast{
 position:fixed;
 z-index:200;
 bottom:90px;
 left:50%;
 transform:translateX(-50%);
 background:#222;
 color:white;
 padding:11px 18px;
 border-radius:30px;
 font-size:11px;
 display:none;
 white-space:nowrap;
}

</style>
</head>


<body>

